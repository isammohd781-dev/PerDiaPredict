{
  "name": "PerdiaPredict",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "python -m streamlit run diabetes_app.py --server.address=0.0.0.0"
  },
  "forwardPorts": [
    8501
  ]
}